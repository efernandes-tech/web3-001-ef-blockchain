# ============================================================
# Deploy config for scripts/deploy.sh
# Copy to .env and fill in real values (never commit .env).
# ============================================================

# GitHub Container Registry
# GitHub username, lowercase
GHCR_USER=
# Classic PAT with read:packages + write:packages
GHCR_TOKEN=
# Image prefix: your GitHub username (lowercase). Images become
# ghcr.io/<GHCR_IMAGE_PREFIX>/<app>:<sha>
GHCR_IMAGE_PREFIX=

# CapRover machine URL
CAPROVER_URL=https://caprover.edersonfernandes.tec.br

# App tokens: CapRover dashboard -> App -> Deployment -> Enable App Token
# One per deployable app. Used by image deploys (no master password needed).
CAPROVER_APP_TOKEN_SERVER=
CAPROVER_APP_TOKEN_MINER=
CAPROVER_APP_TOKEN_SITE=
CAPROVER_APP_TOKEN_DOCS=

# Master password. ONLY used by the legacy --tarball fallback.
# Prefer leaving this empty and using `caprover login` once instead.
CAPROVER_PASSWORD=

# Site build arg: API URL baked into the Vite build
VITE_API_URL=https://server-ef-blockchain.caprover.edersonfernandes.tec.br
